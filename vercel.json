
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?=.*(?:FBAN|FBAV|FB_IAB))(?=.*(?:Android|iPhone|iPod|Mobile))"
        }
      ],
      "destination": "https://YOUR-LINK-1.com",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://YOUR-LINK-2.com",
      "permanent": false
    }
  ]
}
